diff --git a/src/pipewire_cursor.hpp b/src/pipewire_cursor.hpp
new file mode 100644
--- /dev/null
+++ b/src/pipewire_cursor.hpp
@@ -0,0 +1,99 @@
+#pragma once
+
+#include <cerrno>
+#include <cstring>
+#include <string>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+// One connection owns the PipeWire cursor request for its lifetime.
+class PipeWireCursorControl
+{
+public:
+	PipeWireCursorControl() = default;
+	PipeWireCursorControl(const PipeWireCursorControl &) = delete;
+	PipeWireCursorControl &operator=(const PipeWireCursorControl &) = delete;
+
+	~PipeWireCursorControl()
+	{
+		if (m_client >= 0)
+			close(m_client);
+		if (m_listener >= 0)
+			close(m_listener);
+		if (!m_path.empty())
+			unlink(m_path.c_str());
+	}
+
+	bool Open(const char *path)
+	{
+		sockaddr_un address = {};
+		address.sun_family = AF_UNIX;
+		if (std::strlen(path) >= sizeof(address.sun_path))
+		{
+			errno = ENAMETOOLONG;
+			return false;
+		}
+		std::strcpy(address.sun_path, path);
+
+		int listener = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+		if (listener < 0)
+			return false;
+
+		const bool bound = bind(listener, reinterpret_cast<const sockaddr *>(&address), sizeof(address)) == 0;
+		if (!bound || listen(listener, 1) < 0)
+		{
+			int error = errno;
+			close(listener);
+			if (bound)
+				unlink(path);
+			errno = error;
+			return false;
+		}
+		m_listener = listener;
+		m_path = path;
+		return true;
+	}
+
+	bool ReadVisible()
+	{
+		if (m_listener < 0)
+			return false;
+		if (m_client < 0)
+			m_client = accept4(m_listener, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+		if (m_client < 0)
+			return false;
+
+		pollfd event = {m_client, POLLIN | POLLRDHUP, 0};
+		if (poll(&event, 1, 0) <= 0)
+			return m_visible;
+		if (event.revents & (POLLRDHUP | POLLHUP | POLLERR | POLLNVAL))
+			return Disconnect();
+
+		char commands[64];
+		ssize_t count = recv(m_client, commands, sizeof(commands), 0);
+		if (count == 0 || (count < 0 && errno != EAGAIN && errno != EINTR))
+			return Disconnect();
+		for (ssize_t index = 0; index < count; index++)
+		{
+			if (commands[index] == '0' || commands[index] == '1')
+				m_visible = commands[index] == '1';
+		}
+		return m_visible;
+	}
+
+private:
+	bool Disconnect()
+	{
+		close(m_client);
+		m_client = -1;
+		m_visible = false;
+		return false;
+	}
+
+	int m_listener = -1;
+	int m_client = -1;
+	bool m_visible = false;
+	std::string m_path;
+};
